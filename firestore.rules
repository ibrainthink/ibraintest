rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function myUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isApproved() {
      return isSignedIn() && myUserDoc().approved == true;
    }
    function isAdmin() {
      return isSignedIn() && myUserDoc().isAdmin == true;
    }
    function ownsStudent(studentId) {
      return isApproved()
        && get(/databases/$(database)/documents/students/$(studentId)).data.createdBy == request.auth.uid;
    }

    match /users/{userId} {
      // 가입자가 승인/관리자 권한을 스스로 부여하지 못하게 합니다.
      allow create: if isSignedIn() && request.auth.uid == userId
        && request.resource.data.get('approved', false) == false
        && request.resource.data.get('isAdmin', false) == false;
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /students/{studentId} {
      allow create: if isApproved()
        && request.resource.data.createdBy == request.auth.uid;
      allow read, delete: if isApproved()
        && resource.data.createdBy == request.auth.uid;
      allow update: if isApproved()
        && resource.data.createdBy == request.auth.uid
        && request.resource.data.createdBy == resource.data.createdBy;

      match /evaluations/{evalId} {
        // 평가는 평가 작성자 대신 소속 학생의 소유권으로 보호합니다.
        allow read, delete: if ownsStudent(studentId);
        allow create: if ownsStudent(studentId)
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if ownsStudent(studentId)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdBy']);
      }
    }
  }
}
